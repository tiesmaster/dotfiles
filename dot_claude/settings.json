{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:grafana.github.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:release-assets.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:get.helm.sh)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:dns.google)",
      "WebFetch(domain:kubereboot.github.io)",
      "WebFetch(domain:proxy.golang.org)"
    ],
    "deny": [
      "Read(~/.kube/**)",
      "Read(~/.talos/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.config/chezmoi/key.txt)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi cat:*)",
      "Bash(chezmoi apply -v:*)",
      "Bash(chezmoi update -v:*)",
      "Bash(chezmoi decrypt:*)",
      "Bash(age -d:*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "/Users/ties/.gitconfig-identity",
        "/Users/ties/.gitconfig-guida",
        "/Users/ties/.gitconfig-guida-identity",
        "/Users/ties/.config/glab-cli/config.yml"
      ]
    }
  },
  "model": "opus",
  "skillOverrides": {
    "summarize-changes": "off"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
