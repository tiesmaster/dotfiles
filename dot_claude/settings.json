{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:grafana.github.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:release-assets.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:get.helm.sh)",
      "WebFetch(domain:hub.docker.com)"
    ],
    "deny": [
      "Read(~/.kube/**)",
      "Read(~/.talos/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.config/chezmoi/key.txt)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi cat:*)",
      "Bash(chezmoi apply -v:*)",
      "Bash(chezmoi update -v:*)",
      "Bash(chezmoi decrypt:*)",
      "Bash(age -d:*)"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "summarize-changes": "off"
  },
  "tui": "fullscreen",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
